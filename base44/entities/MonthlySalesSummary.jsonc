{
  "name": "MonthlySalesSummary",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "Month in YYYY-MM format"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer identifier"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "brand": {
      "type": "string",
      "description": "Product brand"
    },
    "sales_representative": {
      "type": "string",
      "description": "Sales rep name"
    },
    "total_quantity": {
      "type": "number",
      "description": "Total units sold"
    },
    "total_sales": {
      "type": "number",
      "description": "Total sales value"
    },
    "total_discount": {
      "type": "number",
      "description": "Total discounts"
    },
    "total_tax": {
      "type": "number",
      "description": "Total tax"
    },
    "orders_count": {
      "type": "number",
      "description": "Number of unique orders"
    },
    "summary_key": {
      "type": "string",
      "description": "Unique key for upsert"
    }
  },
  "required": [
    "month"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.sales_representative": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}