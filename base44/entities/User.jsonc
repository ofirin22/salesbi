{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "not_active"
      ],
      "default": "active"
    }
  }
}